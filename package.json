{
  "name": "stockflow",
  "version": "0.1.0",
  "description": "STOCKFLOW — Gestion de stock, ventes et livraisons pour magasin d'ordinateurs (neuf, occasion, reconditionné)",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/sqlite3/build/Release/*.node",
      "node_modules/sqlite3/lib/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
